# production/config/production.env — the one place that names WHAT is deployed.
#
# Sourced by every phase script. Values here are identifiers and paths only: no
# behaviour, no credentials. Anything that changes how the platform BEHAVES
# belongs in the kustomize tree (k8s/ + overlays/), never here — see
# production/README.md, rule 2.
#
# Override any value for a one-off run by exporting it before invoking
# contest.sh; every assignment below is `:=` so the environment wins.

# ── AWS / cluster identity ───────────────────────────────────────────────────
# AWS_PROFILE matters: the default profile on this machine is a different
# account in a different region, and using it silently builds the wrong cluster.
: "${AWS_PROFILE:=iicpc}"
: "${AWS_REGION:=us-east-1}"
: "${CLUSTER_NAME:=iicpc-contest}"

# ── Declarative assets this path CONSUMES ────────────────────────────────────
# These are the source of truth and are deliberately NOT copied into
# production/. Scripts get rewritten here; declarative assets get referenced.
# TFVARS is relative to TF_DIR because terraform resolves -var-file from its
# own -chdir.
: "${TF_DIR:=infra/terraform-v2}"
: "${TFVARS:=tfvars/contest.tfvars}"
: "${OVERLAY:=overlays/eks-contest}"

# ── Expected cluster shape, asserted after provisioning ──────────────────────
# Pool label -> expected node count. `general` is matched on `role`, not `pool`
# (terraform labels that group differently); 05-verify.sh handles both.
: "${EXPECT_GENERAL_NODES:=2}"
: "${EXPECT_KAFKA_NODES:=1}"
: "${EXPECT_SANDBOX_NODES:=1}"
: "${EXPECT_BOTWORKER_NODES:=2}"

# ── Smoke run ────────────────────────────────────────────────────────────────
# A contestant KNOWN to qualify, so a bad score means the platform is broken
# rather than the engine. reference-clob-fix.zip is FIX/9898 and scored 0.9921
# on EKS on 2026-08-03.
: "${SMOKE_FIXTURE:=production/fixtures/reference-clob-fix.zip}"
: "${SMOKE_MIN_SCORE:=0.95}"
# Identity the smoke submission uses. MUST match DEFAULT_CONTESTANT_ID on
# submission-api (k8s/platform/submission-api/deployment.yaml) or the API's
# owner-scoped 404 makes the benchmark trigger unreachable.
: "${SMOKE_CONTESTANT:=echo-contestant}"

# ── Local ports used for port-forwards during smoke/verify ───────────────────
# Chosen to not collide with the documented manual forwards (8088/3001/3000).
: "${PORT_SUBMISSION_API:=18088}"
: "${PORT_FRONTEND:=13001}"
